# -----------------------------------------------------------------------------
# n8n runtime
# -----------------------------------------------------------------------------
# Pin upgrades deliberately. Review n8n release notes before changing this tag.
N8N_VERSION=2.6.4

# Local defaults. In production use the public hostname and HTTPS.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# Required because the portable workflows read provider settings from $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Use 1 when n8n is behind one reverse proxy or Cloudflare Tunnel; otherwise 0.
N8N_PROXY_HOPS=0

# Generate with: openssl rand -hex 32
# Keep this stable after first startup or saved n8n credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value

# n8n and workflow timezone.
GENERIC_TIMEZONE=Africa/Casablanca
TZ=Africa/Casablanca

# Set true behind a production HTTPS reverse proxy.
N8N_SECURE_COOKIE=false

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Permanent or long-lived System User token with the minimum WhatsApp scopes.
WHATSAPP_ACCESS_TOKEN=

# Found in Meta App Dashboard > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any private random value; enter the same value in Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# Meta App Dashboard > App settings > Basic > App secret.
# Required when VERIFY_META_SIGNATURE=true.
WHATSAPP_APP_SECRET=

# Keep the Graph version explicit so upgrades are deliberate.
WHATSAPP_GRAPH_VERSION=v23.0

# false is convenient for local curl tests. Set true before production traffic.
VERIFY_META_SIGNATURE=false

# Long random token for the protected handoff-clear webhook.
# Generate with: openssl rand -hex 32
HANDOFF_ADMIN_TOKEN=replace-with-a-separate-long-random-value

# -----------------------------------------------------------------------------
# AI provider (Groq free tier by default)
# -----------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Optional legacy OpenAI compatibility. Leave blank when using AI_* above.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Optional future persistence
# -----------------------------------------------------------------------------
# Not used by the MVP workflow. Reserved for the PostgreSQL migration described
# in docs/n8n-setup.md.
DATABASE_URL=
